# Optional local API port; default used by pnpm start.
PORT=4500

# Test payments only. Never commit real secrets.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=test_...
# PAYMENT_RETURN_URL=https://your-backend.example/

# Private directory on an attached persistent disk.
# ROASTORY_DATA_DIRECTORY=/var/lib/roastory


# Optional free external PostgreSQL; set the real URI in hosting secrets only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/roastory?sslmode=verify-full
